process.executor = 'awsbatch'
process.queue = 'batch-computing-workloads-low-priority-job-queue'

aws.region = 'us-east-1'
aws.batch.jobRole = 'arn:aws:iam::249640142434:role/batch-nextflow'
aws.batch.executionRole = 'arn:aws:iam::249640142434:role/batch-computing-workloads-ecs-task-execution-role'
aws.batch.platformType = 'fargate'

// workDir = '/workflow/nextflow'
workDir = 's3://sanders-lab/MikeG/nextflow'
wave.enabled = false

includeConfig "conf/base.config"

params {
    work_path = "s3://brainvar2/QTL/input_3152025/"
//    genotype_vcf = "s3://brainvar2/wgs_bv1_and_bv2/brainvar2.022924.joint_called.recalibrated.varQC.AF.vcf.bgz"
    genotype_vcf = "s3://brainvar2/wgs_bv1_and_bv2/brainvar2.022924.joint_called.recalibrated.varQC.AF0.02.vcf.gz"
    genotype_plink_name = "brainvar2.022924.joint_called.recalibrated.varQC.AF0.02.plink"
    sample_information_file = "s3://brainvar2/QTL/samples.psam"
    plink_par = "hg38"
    plink_bed = "s3://brainvar2/QTL/input_3152025/plink_vcf/brainvar2.022924.joint_called.recalibrated.varQC.AF0.02.plink.bed"
    plink_bim = "s3://brainvar2/QTL/input_3152025/plink_vcf/brainvar2.022924.joint_called.recalibrated.varQC.AF0.02.plink.bim"
    plink_fam = "s3://brainvar2/QTL/input_3152025/plink_vcf/brainvar2.022924.joint_called.recalibrated.varQC.AF0.02.plink.fam"
}
