params {
    stage             = 'parabricks'
    input             = "${projectDir}/tests/fixtures/parabricks_samplesheet.csv"
    outdir            = "${projectDir}/results-test-parabricks"
    parabricks_refdir = "${projectDir}/tests/fixtures/parabricks_reference"
    fasta_basename    = 'Homo_sapiens_assembly38.fasta'
    known_sites       = "${projectDir}/tests/fixtures/parabricks_reference/dbsnp.vcf.gz,${projectDir}/tests/fixtures/parabricks_reference/axiom.vcf.gz,${projectDir}/tests/fixtures/parabricks_reference/mills.vcf.gz"
    known_sites_indexes = "${projectDir}/tests/fixtures/parabricks_reference/dbsnp.vcf.gz.tbi,${projectDir}/tests/fixtures/parabricks_reference/axiom.vcf.gz.tbi,${projectDir}/tests/fixtures/parabricks_reference/mills.vcf.gz.tbi"
}

process {
    cpus   = 1
    memory = 1.GB
    time   = 10.m

    withLabel: process_gpu {
        cpus        = 1
        memory      = 1.GB
        time        = 10.m
        accelerator = 0
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
