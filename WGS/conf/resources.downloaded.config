// Canonical paths created by scripts/utility/download_resources.sh.
def grch38 = "${baseDir}/resources/GRCh38"
def sequence = "${grch38}/Sequence"
def gatkBundle = "${grch38}/Annotation/GATKBundle"

params {
    parabricks_refdir = "${sequence}/BWAIndex"
    fasta_basename    = 'Homo_sapiens_assembly38.fasta'
    known_sites       = "${gatkBundle}/dbsnp_138.hg38.vcf.gz,${gatkBundle}/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz,${gatkBundle}/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    known_sites_indexes = "${gatkBundle}/dbsnp_138.hg38.vcf.gz.tbi,${gatkBundle}/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz.tbi,${gatkBundle}/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"

    fasta               = "${sequence}/WholeGenomeFasta/Homo_sapiens_assembly38.fasta"
    fai                 = "${sequence}/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai"
    dict                = "${sequence}/WholeGenomeFasta/Homo_sapiens_assembly38.dict"
    dbsnp               = "${gatkBundle}/dbsnp_138.hg38.vcf.gz"
    dbsnp_index         = "${gatkBundle}/dbsnp_138.hg38.vcf.gz.tbi"
    hapmap              = "${gatkBundle}/hapmap_3.3.hg38.vcf.gz"
    hapmap_index        = "${gatkBundle}/hapmap_3.3.hg38.vcf.gz.tbi"
    omni                = "${gatkBundle}/1000G_omni2.5.hg38.vcf.gz"
    omni_index          = "${gatkBundle}/1000G_omni2.5.hg38.vcf.gz.tbi"
    one_thousand_g       = "${gatkBundle}/1000G_phase1.snps.high_confidence.hg38.vcf.gz"
    one_thousand_g_index = "${gatkBundle}/1000G_phase1.snps.high_confidence.hg38.vcf.gz.tbi"
    axiom               = "${gatkBundle}/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz"
    axiom_index         = "${gatkBundle}/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz.tbi"
    mills               = "${gatkBundle}/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    mills_index         = "${gatkBundle}/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
}
