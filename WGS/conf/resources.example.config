// Copy to an untracked site-specific config and replace every path.
params {
    parabricks_refdir = '/path/to/parabricks_grch38_reference_directory'
    fasta_basename    = 'Homo_sapiens_assembly38.fasta'
    known_sites       = '/path/to/dbsnp_138.hg38.vcf.gz,/path/to/Axiom_Exome_Plus.hg38.vcf.gz,/path/to/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    known_sites_indexes = '/path/to/dbsnp_138.hg38.vcf.gz.tbi,/path/to/Axiom_Exome_Plus.hg38.vcf.gz.tbi,/path/to/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi'

    fasta               = '/path/to/Homo_sapiens_assembly38.fasta'
    fai                 = '/path/to/Homo_sapiens_assembly38.fasta.fai'
    dict                = '/path/to/Homo_sapiens_assembly38.dict'
    dbsnp               = '/path/to/dbsnp_138.hg38.vcf.gz'
    dbsnp_index         = '/path/to/dbsnp_138.hg38.vcf.gz.tbi'
    hapmap              = '/path/to/hapmap_3.3.hg38.vcf.gz'
    hapmap_index        = '/path/to/hapmap_3.3.hg38.vcf.gz.tbi'
    omni                = '/path/to/1000G_omni2.5.hg38.vcf.gz'
    omni_index          = '/path/to/1000G_omni2.5.hg38.vcf.gz.tbi'
    one_thousand_g       = '/path/to/1000G_phase1.snps.high_confidence.hg38.vcf.gz'
    one_thousand_g_index = '/path/to/1000G_phase1.snps.high_confidence.hg38.vcf.gz.tbi'
    axiom               = '/path/to/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz'
    axiom_index         = '/path/to/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz.tbi'
    mills               = '/path/to/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    mills_index         = '/path/to/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi'
}
