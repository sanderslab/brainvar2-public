params {
    stage               = 'joint'
    input               = "${projectDir}/tests/fixtures/joint_samplesheet.csv"
    outdir              = "${projectDir}/results-test-joint"
    cohort              = 'reviewer_cohort'
    contigs             = 'chr1'
    fasta               = "${projectDir}/tests/fixtures/reference/Homo_sapiens_assembly38.fasta"
    fai                 = "${projectDir}/tests/fixtures/reference/Homo_sapiens_assembly38.fasta.fai"
    dict                = "${projectDir}/tests/fixtures/reference/Homo_sapiens_assembly38.dict"
    dbsnp               = "${projectDir}/tests/fixtures/reference/dbsnp.vcf.gz"
    dbsnp_index         = "${projectDir}/tests/fixtures/reference/dbsnp.vcf.gz.tbi"
    hapmap              = "${projectDir}/tests/fixtures/reference/hapmap.vcf.gz"
    hapmap_index        = "${projectDir}/tests/fixtures/reference/hapmap.vcf.gz.tbi"
    omni                = "${projectDir}/tests/fixtures/reference/omni.vcf.gz"
    omni_index          = "${projectDir}/tests/fixtures/reference/omni.vcf.gz.tbi"
    one_thousand_g       = "${projectDir}/tests/fixtures/reference/1000G.vcf.gz"
    one_thousand_g_index = "${projectDir}/tests/fixtures/reference/1000G.vcf.gz.tbi"
    axiom               = "${projectDir}/tests/fixtures/reference/axiom.vcf.gz"
    axiom_index         = "${projectDir}/tests/fixtures/reference/axiom.vcf.gz.tbi"
    mills               = "${projectDir}/tests/fixtures/reference/mills.vcf.gz"
    mills_index         = "${projectDir}/tests/fixtures/reference/mills.vcf.gz.tbi"
}

process {
    cpus   = 1
    memory = 1.GB
    time   = 10.m

    withLabel: process_low {
        cpus   = 1
        memory = 1.GB
        time   = 10.m
    }

    withLabel: process_medium {
        cpus   = 1
        memory = 1.GB
        time   = 10.m
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
