manifest {
    name            = 'BrainVar2 WGS workflow'
    description     = 'GRCh38 Parabricks germline calling and GATK joint genotyping'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.1'
    version         = '0.1.0-rc.1'
}

params {
    stage             = null
    input             = null
    outdir            = 'results'
    cohort            = 'brainvar2'
    contigs           = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM'

    parabricks_refdir = null
    fasta_basename    = 'Homo_sapiens_assembly38.fasta'
    known_sites       = null
    known_sites_indexes = null

    fasta             = null
    fai               = null
    dict              = null
    dbsnp             = null
    dbsnp_index       = null
    hapmap             = null
    hapmap_index       = null
    omni               = null
    omni_index         = null
    one_thousand_g     = null
    one_thousand_g_index = null
    axiom              = null
    axiom_index        = null
    mills              = null
    mills_index        = null
}

process {
    executor      = 'local'
    errorStrategy = 'terminate'
    shell         = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_gpu {
        cpus        = 24
        memory      = 200.GB
        time        = 48.h
        accelerator = 1
    }

    withLabel: process_low {
        cpus   = 2
        memory = 8.GB
        time   = 12.h
    }

    withLabel: process_medium {
        cpus   = 4
        memory = 24.GB
        time   = 24.h
    }

    withName: PARABRICKS_FQ2BAM {
        publishDir = [
            path: { "${params.outdir}/parabricks/cram" },
            mode: 'copy',
            saveAs: { name -> name == 'versions.yml' ? null : name }
        ]
    }

    withName: PARABRICKS_HAPLOTYPECALLER {
        publishDir = [
            path: { "${params.outdir}/parabricks/gvcf" },
            mode: 'copy',
            saveAs: { name -> name == 'versions.yml' ? null : name }
        ]
    }

    withName: GATK4_GENOMICSDBIMPORT {
        ext.args = '--consolidate --batch-size 50 --overwrite-existing-genomicsdb-workspace'
    }

    withName: GATK4_VARIANTRECALIBRATOR_SNP {
        publishDir = [
            path: { "${params.outdir}/joint/vqsr_models" },
            mode: 'copy',
            saveAs: { name -> name == 'versions.yml' ? null : name }
        ]
    }

    withName: GATK4_VARIANTRECALIBRATOR_INDEL {
        publishDir = [
            path: { "${params.outdir}/joint/vqsr_models" },
            mode: 'copy',
            saveAs: { name -> name == 'versions.yml' ? null : name }
        ]
    }

    withName: GATK4_MERGEVCFS_FINAL {
        publishDir = [
            path: { "${params.outdir}/joint/final_callset" },
            mode: 'copy',
            saveAs: { name -> name == 'versions.yml' ? null : name }
        ]
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
    }

    gpu_docker {
        docker.enabled    = true
        docker.runOptions = '--gpus all'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    gpu_singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '--nv'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
