process.executor = 'awsbatch'
process.queue = 'batch-computing-workloads-low-priority-job-queue'

aws.region = 'us-east-1'
aws.batch.jobRole = 'arn:aws:iam::249640142434:role/batch-nextflow'
aws.batch.executionRole = 'arn:aws:iam::249640142434:role/batch-computing-workloads-ecs-task-execution-role'
aws.batch.platformType = 'fargate'

workDir = 's3://ox.paediatrics.sanders.batch/nextflow/brainvar2_alignment_pipeline'
wave.enabled = false

includeConfig "conf/base.config"

params {
    work_path = "s3://brainvar2/"

    s3_bucket = "s3://brainvar2"
    aligned_folder = "Bulk_RNA/01-aligned"
    star_index = "s3://GRCh38-references/STAR_GRCH38.p13_GENCODEv41_GTEx_no_alt-hla-decoy-contigs"
    threads = 12
    gtf_file = "s3://GRCh38-references/gencode.v41.annotation.gtf"

}

aws {
    client {
        uploadStorageClass = 'INTELLIGENT_TIERING'
    }
}